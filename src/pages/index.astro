---
import Layout from '../layouts/Layout.astro';
import ObraCard from '../components/ObraCard.astro';
import datosObras from '../data/obras.json';

const imagenes = import.meta.glob('../assets/obras/*.{jpg,png,jpeg}', { eager: true });

const obras = Object.keys(imagenes).map((ruta) => {
  const nombreArchivo = ruta.split('/').pop() || ''; 
  const info = datosObras[nombreArchivo] || { titulo: "Sin título", tecnica: "Año desconocido" };

  return {
    imagen: imagenes[ruta].default,
    alt: info.titulo,
    titulo: info.titulo,
    tecnica: info.tecnica,
    nombreArchivo: nombreArchivo
  };
});

obras.sort((a, b) => a.nombreArchivo.localeCompare(b.nombreArchivo));
---

<Layout title="Feliz Cumpleaños">
  <!-- Cabecera emotiva (La entrada al museo) -->
  <header class="hero">
    <div class="globo globo-1"></div>
    <div class="globo globo-2"></div>
    <div class="globo globo-3"></div>

    <div class="hero-contenido">
      <h1>Feliz<br/>Cumpleaños</h1>
      <p>Un pequeño museo con todas tus obras. Gracias por pintar nuestro mundo de color.</p>
    </div>
  </header>

  <!-- NUEVO BLOQUE DE BIENVENIDA -->
  <section class="bienvenida">
    <h2>Bienvenidos al Museo de Kat</h2>
  </section>

  <!-- Galería con CSS Grid Nativo -->
  <section class="galeria">
    <div class="grid-obras">
      {obras.map((obra, index) => (
        <ObraCard 
          imagen={obra.imagen} 
          alt={obra.alt} 
          titulo={obra.titulo} 
          tecnica={obra.tecnica} 
          index={index} 
        />
      ))}
    </div>
  </section>

  <footer class="despedida">
    <p>Con todo mi amor, para la artista más importante de mi vida.</p>
  </footer>
</Layout>

<style>
  /* LA PORTADA */
  .hero {
    position: relative; 
    max-width: 900px; 
    margin: 6rem auto 2rem; 
    padding: 6rem 2rem;
    text-align: center;
    background-color: #ffffff; 
    border-radius: 16px;
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.1); 
    overflow: hidden; 
  }

  .hero-contenido {
    position: relative;
    z-index: 10;
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #111;
    text-shadow: 0 2px 10px rgba(255,255,255, 0.8); 
  }

  .hero p {
    font-size: 1.3rem;
    color: #222; 
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
    font-weight: 600; 
  }

  /* LOS GLOBOS */
  .globo {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px); 
    opacity: 0.8; 
    z-index: 1;
  }

  .globo-1 {
    width: 250px;
    height: 250px;
    background-color: #ff8a80; 
    top: -30px;
    left: -30px;
  }

  .globo-2 {
    width: 300px;
    height: 300px;
    background-color: #82b1ff; 
    bottom: -80px;
    right: -50px;
  }

  .globo-3 {
    width: 200px;
    height: 200px;
    background-color: #ffd54f; 
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* BLOQUE BIENVENIDA */
  .bienvenida {
    max-width: 900px; 
    margin: 0 auto 10rem; 
    text-align: center;
  }

  .bienvenida h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    color: #1a1a1a;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* GALERÍA Y GRID (1 COLUMNA) */
  .galeria {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .grid-obras {
    display: grid;
    grid-template-columns: 1fr; 
    gap: 12rem; 
    align-items: center; 
    max-width: 600px; 
    margin: 0 auto; 
  }

  @media (max-width: 640px) {
    .grid-obras {
      grid-template-columns: 1fr;
      gap: 6rem; /* Menos espacio en móvil */
    }
  }

  .despedida {
    text-align: center;
    padding: 6rem 2rem;
    font-style: italic;
    font-size: 1.2rem;
    color: #777;
    border-top: 1px solid #e0e0e0;
    max-width: 900px; 
    margin: 0 auto 6rem auto; 
  }
</style>